# Copy this file to .env and fill in your values
# .env is gitignored — never commit the real .env file

DB_HOST=localhost
DB_PORT=5432
DB_NAME=bankdb
DB_USER=bankuser
DB_PASSWORD=

# Generate with: openssl rand -hex 32
JWT_SECRET=

JWT_EXPIRATION=86400000

# Must be exactly 16 characters (AES-128)
CARD_ENCRYPTION_KEY=
